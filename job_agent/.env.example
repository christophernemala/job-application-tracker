# Copy to job_agent/.env and fill real values. Never commit .env.

# Required for the Flask dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-please
FLASK_SECRET_KEY=            # generate: python -c "import secrets; print(secrets.token_hex(32))"

# Job site credentials
NAUKRI_GULF_EMAIL=your-email@example.com
NAUKRI_GULF_PASSWORD=your-secure-password

# Candidate info
JOB_AGENT_NAME=Christopher Nemala
JOB_AGENT_EMAIL=christophernemala@gmail.com

# Optional integrations
SLACK_WEBHOOK_URL=           # Slack Incoming Webhook URL
APIFY_TOKEN=                 # Apify API token for scraping runners
OPENAI_API_KEY=              # For AI cover letters
NOTION_API_KEY=              # For Notion sync
NOTION_DATABASE_ID=
